# Formspree endpoint for the contact form (src/services/leadCapture.ts).
# This is a public form action URL, not a secret, so it's fine to expose via the
# VITE_ prefix (Vite inlines VITE_-prefixed vars into the client bundle).
#
# To swap in a different Formspree form (e.g. a new project or a second inbox),
# create a form at https://formspree.io, copy its endpoint, and set it here:
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mwvgaqdq

# Email provider credentials for newsletter signup (src/services/leadCapture.ts).
# Currently unused — submitNewsletterSignup only mocks this call.
#
# Keep these server-side only (e.g. a serverless function / API route) once wired up.
# Do NOT prefix with VITE_ — Vite inlines VITE_-prefixed vars into the client bundle,
# which would publicly expose the key.

EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_FROM_EMAIL=
NEWSLETTER_LIST_ID=
